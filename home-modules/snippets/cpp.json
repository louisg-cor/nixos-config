{
  "doxygen_func": {
    "prefix": "dox_func",
    "body": [
      "/**",
      " * @brief ${1:Résumé court}",
      " *",
      " * @param ${2:param} ${3:description}",
      " * @return ${4:description du retour}",
      " */"
    ],
    "description": "Bloc Doxygen pour une fonction"
  },
  "doxygen_struct": {
    "prefix": "dox_struct",
    "body": [
      "/**",
      " * @brief ${1:short explanation}",
      " *",
      " * @details ${4:more details}",
      " */"
    ]
  },
  "doxygen_member": {
    "prefix": "dox_member",
    "body": [
      "///< explanation"
    ]
  }
}
